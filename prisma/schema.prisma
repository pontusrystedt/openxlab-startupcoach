generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  SYSTEM_ADMIN
  CLIENT_ADMIN
  COACH
  ENTREPRENEUR
}

enum OrgPlan {
  STANDARD
  ENTERPRISE
}

enum StartupStatus {
  SCREENING
  COACHING
  ALUMNI
  ARCHIVED
}

enum Language {
  SWEDISH
  ENGLISH
}

enum AiStatus {
  ON_TRACK
  WARNING
  OFF_TRACK
}

enum SessionPhase {
  SOCIAL
  IRL_CHECK
  COACHING
  PRIORITIZATION
  CLOSING
}

enum TodoStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  DELETED
}

enum FundingStatus {
  PLANNED
  ACTIVE
  CLOSED
  NOT_DEFINED
}

enum KnowledgeType {
  FILE
  LINK
}

enum DecisionStatus {
  NOT_STARTED
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum ScreeningOutcome {
  PENDING
  APPROVED
  REJECTED
}

enum AlumniEventType {
  MEETING
  PRESENTATION
  NOTE
  MILESTONE
}

// ── Organization ──────────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      OrgPlan  @default(STANDARD)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  startups       Startup[]
  programs       Program[]
  knowledge      KnowledgeItem[]
  funderProjects FunderProject[]
  coachMeetings  CoachMeeting[]
  decisions      Decision[]

  @@index([slug])
}

// ── User ──────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  passwordHash        String
  role                Role
  isActive            Boolean   @default(true)
  emailVerified       Boolean   @default(false)
  emailVerifyToken    String?
  forcePasswordChange Boolean   @default(false)
  klangApiKey         String?
  totpSecret          String?
  totpEnabled         Boolean   @default(false)
  totpVerifiedAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  startup   Startup?      @relation(fields: [startupId], references: [id])
  startupId String?

  org   Organization? @relation(fields: [orgId], references: [id])
  orgId String?

  @@index([email])
  @@index([orgId])
}

// ── Program ───────────────────────────────────────────────────────────────

model Program {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  orgId       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org                Organization        @relation(fields: [orgId], references: [id])
  questionDoc        ProgramQuestionDoc?
  startups           Startup[]
  screeningResponses ScreeningResponse[]

  @@index([orgId])
}

model ProgramQuestionDoc {
  id            String   @id @default(cuid())
  fileName      String
  storageKey    String
  extractedText String
  uploadedAt    DateTime @default(now())
  uploadedBy    String
  programId     String   @unique

  program Program @relation(fields: [programId], references: [id])
}

// ── Startup ───────────────────────────────────────────────────────────────

model Startup {
  id                  String        @id @default(cuid())
  name                String
  sector              String
  status              StartupStatus @default(SCREENING)
  contactEmail        String?
  contactPhone        String?
  orgNumber           String?
  registeredAt        DateTime?
  postAddress         String?
  preferredLanguage   Language      @default(SWEDISH)
  founderOwnershipPct Int?
  activeOwnerPct      Int?
  businessIdea        String?
  aiStatus            AiStatus      @default(ON_TRACK)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  screeningOutcome             ScreeningOutcome @default(PENDING)
  screeningMeetingId           String?          // klangFileId för screeningmötet
  screeningTranscriptEncrypted String?
  screeningTranscriptIv        String?
  screeningTranscriptAuthTag   String?

  org   Organization? @relation(fields: [orgId], references: [id])
  orgId String?

  program   Program? @relation(fields: [programId], references: [id])
  programId String?

  users               User[]
  sessions            Session[]
  irlProfiles         IrlProfile[]
  fundingRound        FundingRound?
  teamMembers         TeamMember[]
  files               StartupFile[]
  funderProjects      StartupFunderProject[]
  screeningResponses  ScreeningResponse[]
  screeningAnalysis   ScreeningAnalysis?
  decisions           Decision[]
  alumniEvents        AlumniEvent[]

  @@index([orgId])
  @@index([status])
}

// ── TeamMember ────────────────────────────────────────────────────────────

model TeamMember {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  email           String
  phone           String?
  role            String?
  isMainContact   Boolean  @default(false)
  hasSystemAccess Boolean  @default(false)
  createdAt       DateTime @default(now())

  startup   Startup @relation(fields: [startupId], references: [id])
  startupId String

  @@index([startupId])
}

// ── StartupFile ───────────────────────────────────────────────────────────

model StartupFile {
  id            String   @id @default(cuid())
  type          String   @default("FILE") // "FILE" | "LINK"
  fileName      String?
  mimeType      String?
  sizeBytes     Int?
  storageKey    String?
  url           String?
  title         String?
  uploadedBy    String
  uploadedAt    DateTime @default(now())
  description   String?
  extractedText String?

  startup   Startup @relation(fields: [startupId], references: [id])
  startupId String

  @@index([startupId])
}

// ── KnowledgeItem ─────────────────────────────────────────────────────────

model KnowledgeItem {
  id            String        @id @default(cuid())
  type          KnowledgeType
  title         String
  url           String?
  storageKey    String?
  fileName      String?
  mimeType      String?
  keywords      String[]
  extractedText String?
  uploadedBy    String
  createdAt     DateTime      @default(now())
  orgId         String

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

// ── FunderProject ─────────────────────────────────────────────────────────

model FunderProject {
  id              String   @id @default(cuid())
  name            String
  funderName      String
  periodStart     DateTime
  periodEnd       DateTime
  requirementDoc  String?
  requirementText String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  orgId           String

  org      Organization           @relation(fields: [orgId], references: [id])
  startups StartupFunderProject[]
  files    FunderProjectFile[]
  meetings ProjectMeeting[]
  todos    ProjectTodo[]

  @@index([orgId])
}

model FunderProjectFile {
  id            String   @id @default(cuid())
  type          String   @default("FILE") // "FILE" | "LINK"
  fileName      String?
  mimeType      String?
  sizeBytes     Int?
  storageKey    String?
  url           String?
  title         String?
  uploadedBy    String
  uploadedAt    DateTime @default(now())
  extractedText String?

  project   FunderProject @relation(fields: [projectId], references: [id])
  projectId String

  @@index([projectId])
}

model StartupFunderProject {
  id        String   @id @default(cuid())
  joinedAt  DateTime @default(now())
  notes     String?
  startupId String
  projectId String

  startup Startup       @relation(fields: [startupId], references: [id])
  project FunderProject @relation(fields: [projectId], references: [id])

  @@unique([startupId, projectId])
}

model ProjectMeeting {
  id                  String    @id @default(cuid())
  meetingNumber       Int
  scheduledAt         DateTime
  klangFileId         String?
  linkedBy            String?   // userId som kopplade Klang-mötet
  transcriptEncrypted String?
  transcriptIv        String?
  transcriptAuthTag   String?
  summaryInsight      String?
  summaryCoachNote    String?
  createdAt           DateTime  @default(now())

  project   FunderProject @relation(fields: [projectId], references: [id])
  projectId String

  todos ProjectTodo[]

  @@index([projectId])
  @@index([klangFileId])
}

model ProjectTodo {
  id        String    @id @default(cuid())
  text      String
  status    String    @default("NOT_STARTED")
  priority  Int       @default(0)
  dueDate   DateTime?
  createdAt DateTime  @default(now())

  project   FunderProject   @relation(fields: [projectId], references: [id])
  projectId String

  meeting   ProjectMeeting? @relation(fields: [meetingId], references: [id])
  meetingId String?

  @@index([projectId])
}

// ── Session ───────────────────────────────────────────────────────────────

model Session {
  id            String       @id @default(cuid())
  sessionNumber Int
  scheduledAt   DateTime
  completedAt   DateTime?
  durationMin   Int?
  phase         SessionPhase @default(COACHING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  startup   Startup @relation(fields: [startupId], references: [id])
  startupId String

  transcript Transcript?
  summary    SessionSummary?
  todos      Todo[]

  @@index([startupId])
}

// ── Transcript ────────────────────────────────────────────────────────────

model Transcript {
  id              String   @id @default(cuid())
  klangFileId     String   @unique
  encryptedText   String
  iv              String
  authTag         String
  durationSeconds Int?
  createdAt       DateTime @default(now())

  session   Session @relation(fields: [sessionId], references: [id])
  sessionId String  @unique

  @@index([klangFileId])
}

// ── SessionSummary ────────────────────────────────────────────────────────

model SessionSummary {
  id            String   @id @default(cuid())
  encryptedData String
  iv            String
  authTag       String
  createdAt     DateTime @default(now())

  session   Session @relation(fields: [sessionId], references: [id])
  sessionId String  @unique
}

// ── Todo ──────────────────────────────────────────────────────────────────

model Todo {
  id          String     @id @default(cuid())
  text        String
  comment     String?
  priority    Int
  status      TodoStatus @default(NOT_STARTED)
  agentSource String?
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  session   Session @relation(fields: [sessionId], references: [id])
  sessionId String

  feedback TodoFeedback?

  @@index([sessionId])
}

// ── TodoFeedback ──────────────────────────────────────────────────────────

model TodoFeedback {
  id        String   @id @default(cuid())
  stars     Int?
  comment   String?
  createdAt DateTime @default(now())

  todo   Todo   @relation(fields: [todoId], references: [id])
  todoId String @unique
}

// ── IrlProfile ────────────────────────────────────────────────────────────

model IrlProfile {
  id        String   @id @default(cuid())
  crl       Int
  trl       Int
  brl       Int
  iprl      Int
  frl       Int
  orl       Int
  notes     String?
  createdAt DateTime @default(now())

  startup   Startup @relation(fields: [startupId], references: [id])
  startupId String

  @@index([startupId])
}

// ── FundingRound ──────────────────────────────────────────────────────────

model FundingRound {
  id        String        @id @default(cuid())
  quarter   String
  amountSek Int?
  roundType String?
  status    FundingStatus @default(PLANNED)
  updatedAt DateTime      @updatedAt

  startup   Startup @relation(fields: [startupId], references: [id])
  startupId String  @unique
}

// ── AgentLog ──────────────────────────────────────────────────────────────

model AgentLog {
  id           String   @id @default(cuid())
  agentName    String
  agentVersion String
  sessionId    String
  inputHash    String
  outputHash   String
  latencyMs    Int
  createdAt    DateTime @default(now())

  @@index([sessionId])
  @@index([agentName, agentVersion])
}

// ── ScreeningResponse ─────────────────────────────────────────────────────

model ScreeningResponse {
  id        String   @id @default(cuid())
  question  String
  aiAnswer  String?
  coachEdit String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  startup   Startup @relation(fields: [startupId], references: [id])
  startupId String

  program   Program @relation(fields: [programId], references: [id])
  programId String

  @@index([startupId])
}

// ── ScreeningAnalysis ─────────────────────────────────────────────────────

model ScreeningAnalysis {
  id             String   @id @default(cuid())
  strengths      String   // JSON-array
  risks          String   // JSON-array
  recommendation String   // "APPROVE" | "REJECT" | "UNCERTAIN"
  reasoning      String
  agentVersion   String   @default("v1")
  coachFeedback  String?
  coachStars     Int?
  createdAt      DateTime @default(now())

  startup   Startup @relation(fields: [startupId], references: [id])
  startupId String  @unique
}

// ── CoachMeeting ──────────────────────────────────────────────────────────

model CoachMeeting {
  id                   String    @id @default(cuid())
  title                String
  meetingDate          DateTime
  klangFileId          String?
  encryptedTranscript  String?
  transcriptIv         String?
  transcriptAuthTag    String?
  agentRan             Boolean   @default(false)
  createdAt            DateTime  @default(now())

  org   Organization @relation(fields: [orgId], references: [id])
  orgId String

  decisions Decision[]

  @@index([orgId])
  @@index([meetingDate])
}

// ── Decision ──────────────────────────────────────────────────────────────

model Decision {
  id          String         @id @default(cuid())
  text        String
  comment     String?
  status      DecisionStatus @default(NOT_STARTED)
  priority    Int            @default(1)
  agentSource String?
  archivedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  meeting   CoachMeeting @relation(fields: [meetingId], references: [id])
  meetingId String

  startup   Startup? @relation(fields: [startupId], references: [id])
  startupId String?

  org   Organization @relation(fields: [orgId], references: [id])
  orgId String

  @@index([orgId])
  @@index([startupId])
  @@index([meetingId])
}

// ── AlumniEvent ───────────────────────────────────────────────────────────

model AlumniEvent {
  id                   String          @id @default(cuid())
  type                 AlumniEventType
  title                String
  description          String?
  eventDate            DateTime
  klangFileId          String?
  encryptedTranscript  String?
  transcriptIv         String?
  transcriptAuthTag    String?
  createdAt            DateTime        @default(now())

  startup   Startup @relation(fields: [startupId], references: [id])
  startupId String

  @@index([startupId])
}
